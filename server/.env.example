# =============================================================================
# Rhapsode — Environment Configuration Reference
# =============================================================================
# Copy this file to .env and fill in your values.  .env is gitignored.
#
# load_dotenv() in app.py loads these into the Python process; the C++ layer
# (pybind11, in-process) sees them via std::getenv automatically.
# =============================================================================


# ─── Cloud LLM Provider ─────────────────────────────────────────────────────
# Consumed by: server/rhapsode/llm.py
#
# RHAPSODE_PROVIDER selects the cloud LLM used for the narrator, reflection,
# weaver, downsampler, scheduler, and lifecycle.  Only ONE provider should be
# active at a time.

RHAPSODE_PROVIDER=gemini
# Options: gemini, deepseek

# --- Gemini ---
GOOGLE_API_KEY=your-api-key-here
# Get your key at https://aistudio.google.com/apikey
# For AthenAI gateway: use your sk-... key from https://athenai.mihoyo.com

# Optional: custom API base URL (leave unset for Google's default endpoint)
#RHAPSODE_API_BASE=https://athenai.mihoyo.com

# Model names: https://ai.google.dev/gemini-api/docs/models
#   gemini-2.0-flash         (fast, cheap — recommended)
#   gemini-2.0-flash-lite    (fastest, cheapest)
#   gemini-2.5-flash-preview-05-20  (thinking model)
#   gemini-2.5-pro-preview-05-06    (best quality, expensive)
# AthenAI also routes models like gpt-5.4, claude-4, deepseek-v4-pro, etc.
RHAPSODE_MODEL=gemini-2.0-flash

# --- DeepSeek (uncomment and set RHAPSODE_PROVIDER=deepseek to activate) ---
#DEEPSEEK_API_KEY=your-deepseek-key
#DEEPSEEK_API_BASE=https://api.deepseek.com
# When using AthenAI for DeepSeek, set both DEEPSEEK_API_BASE and the key to
# your AthenAI credentials.

# Max output tokens per LLM call (all providers).  Raise if a reasoning/"pro"
# model returns empty content with finish_reason=length (it spent the budget on
# hidden reasoning).  Billing is by actual usage, so a higher ceiling is safe.
# On DeepSeek length overflows the client doubles up to 131072 automatically.
RHAPSODE_MAX_OUTPUT_TOKENS=65536

# DeepSeek V4 thinking (chain-of-thought). Default enabled for pro quality.
# Reasoning and final answer share RHAPSODE_MAX_OUTPUT_TOKENS — keep that high.
# Disable only for latency smoke tests.
RHAPSODE_DEEPSEEK_THINKING=enabled
#RHAPSODE_DEEPSEEK_THINKING=disabled


# ─── Scenario & Server ──────────────────────────────────────────────────────
# Consumed by: server/rhapsode/app.py

RHAPSODE_SCENARIO=scenarios/tavern.json
RHAPSODE_HOST=127.0.0.1
RHAPSODE_PORT=8080


# ─── Logging ────────────────────────────────────────────────────────────────
# Python package logger + C++ pipeline (stderr). Same line shape:
#   HH:MM:SS LEVEL component: message
# Default INFO is quiet (turn outcomes). DEBUG or RHAPSODE_VERBOSE_LOG=1 unlocks
# stage detail / prompt dumps.

#RHAPSODE_LOG_LEVEL=INFO
#RHAPSODE_VERBOSE_LOG=1

# Dump full weave prompts/responses to logs/weave-turn-*.txt
#RHAPSODE_WEAVE_LOG=1
#RHAPSODE_WEAVE_LOG_DIR=logs


# ─── C++ Experiment Flags ───────────────────────────────────────────────────
# Consumed via std::getenv in core/src/character_memory.cpp.
# These gate experimental features; set to any value to enable.

# pressing_thought() — surfaces the highest-charge thought as narrator context
#RHAPSODE_EXP_SURFACING=1

# charge_state() — surfaces "tension has become almost unbearable" / "conviction
# has hardened" as narrator context
#RHAPSODE_EXP_CRISIS=1

# A/B control: renders a flat recency view ignoring weight and tension entirely
#RHAPSODE_BASELINE_NO_CHARGE=1
