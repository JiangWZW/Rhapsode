# Get your key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-api-key-here

# Model names: https://ai.google.dev/gemini-api/docs/models
#   gemini-2.0-flash         (fast, cheap — recommended)
#   gemini-2.0-flash-lite    (fastest, cheapest)
#   gemini-2.5-flash-preview-05-20  (thinking model)
#   gemini-2.5-pro-preview-05-06    (best quality, expensive)
RHAPSODE_MODEL=gemini-2.0-flash

RHAPSODE_SCENARIO=scenarios/tavern.json
RHAPSODE_HOST=127.0.0.1
RHAPSODE_PORT=8080
