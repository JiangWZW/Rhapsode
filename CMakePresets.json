{
  "version": 6,
  "configurePresets": [
    {
      "name": "vs2022",
      "displayName": "VS 2022 (Open Folder in Visual Studio)",
      "generator": "Ninja",
      "architecture": { "value": "x64", "strategy": "external" },
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "Python3_EXECUTABLE": "${sourceDir}/server/.venv/Scripts/python.exe"
      },
      "vendor": {
        "microsoft.com/VisualStudioSettings/CMake/1.0": {
          "hostOS": [ "Windows" ],
          "intelliSenseMode": "windows-msvc-x64"
        }
      }
    },
    {
      "name": "default",
      "displayName": "Ninja (command-line build)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "Python3_EXECUTABLE": "${sourceDir}/server/.venv/Scripts/python.exe",
        "CMAKE_MAKE_PROGRAM": "${sourceDir}/server/.venv/Scripts/ninja.exe"
      }
    },
    {
      "name": "msvc2019",
      "displayName": "VS 2019 MSVC (command-line build)",
      "generator": "Visual Studio 16 2019",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "Python3_EXECUTABLE": "${sourceDir}/server/.venv/Scripts/python.exe"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2022",
      "configurePreset": "vs2022"
    },
    {
      "name": "default",
      "configurePreset": "default"
    },
    {
      "name": "msvc2019",
      "configurePreset": "msvc2019",
      "configuration": "Release"
    },
    {
      "name": "default-tests",
      "configurePreset": "default",
      "targets": [ "test_scene" ]
    },
    {
      "name": "msvc2019-tests",
      "configurePreset": "msvc2019",
      "configuration": "Release",
      "targets": [ "test_scene" ]
    }
  ],
  "testPresets": [
    {
      "name": "default",
      "configurePreset": "default",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "msvc2019",
      "configurePreset": "msvc2019",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
