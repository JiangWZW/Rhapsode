+        print(f"{step:<5} {node['id']:<5} {len(chain_edges):<13} {len(clique_edges):<14} {ratio}")
+
+        nodes_so_far = existing[:]
+        render_graph(nodes_so_far, chain_edges[:], step, "chain",
+                     new_node_id=node["id"])
+        render_graph(nodes_so_far, clique_edges[:], step, "clique",
+                     new_node_id=node["id"])
+
+    print(f"\n{'='*55}")
