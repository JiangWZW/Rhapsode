-bool MemorySystem::detect_conflict(const std::string& fact,
-                                   const std::string& embedding_json) const {
-    if (!query_cb_ || !local_llm_cb_) return false;
-
-    nlohmann::json where = {{"state", {{"$ne", "dormant"}}}};
